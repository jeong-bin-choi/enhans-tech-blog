---
const categories = [
  "AI Backend",
  "Infra",
  "DevOps",
  "Forward Deployed Engineer(FDE)",
  "Backend Engineer",
  "Frontend Engineer",
  "Full-Stack Engineer",
  "Data",
  "Product Engineer",
];
---
<aside class="job-filter" aria-label="직무별 필터">
  {categories.map((cat) => (
    <label class="job-filter-item">
      <input type="checkbox" value={cat} />
      <span>{cat}</span>
    </label>
  ))}
</aside>

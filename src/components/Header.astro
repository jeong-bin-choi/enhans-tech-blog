---
const navChev = `<svg class="chev" width="8" height="5" viewBox="0 0 8 5" fill="none"><path d="M1 1l3 3 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="logo enhans-logo" href="/">
      <img src="/assets/enhans-logo.svg" alt="Enhans" class="enhans-logo-img" />
      <span class="tech-blog-label">Tech-blog</span>
    </a>
    <nav class="main-nav">
      <a class="nav-link" href="https://www.enhans.ai/kr/about-us">About Us<Fragment set:html={navChev} /></a>
      <a class="nav-link" href="https://www.enhans.ai/kr">Homepage<Fragment set:html={navChev} /></a>
      <a class="nav-link" href="https://www.enhans.ai/kr/newsroom">Newsroom<Fragment set:html={navChev} /></a>
      <a class="nav-link" href="https://www.enhans.ai/kr/documents">Documents<Fragment set:html={navChev} /></a>
    </nav>
    <div class="header-actions">
      <div class="search-box">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="site-search" placeholder="검색..." />
      </div>
      <a class="nav-link" href="https://enhanscareer.ninehire.site/recruit" target="_blank" rel="noopener noreferrer">Careers<Fragment set:html={navChev} /></a>
      <a class="nav-link" href="https://www.youtube.com/@enhans-ai" target="_blank" rel="noopener noreferrer">Youtube<Fragment set:html={navChev} /></a>
      <a class="nav-link" href="https://www.linkedin.com/company/enhans-ai/posts/?feedView=all" target="_blank" rel="noopener noreferrer">LinkedIn<Fragment set:html={navChev} /></a>
      <button class="mobile-menu-toggle" aria-label="메뉴 열기">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>
  <div class="wrap">
    <nav class="mobile-menu">
      <a href="https://www.enhans.ai/kr/about-us">About Us</a>
      <a href="https://www.enhans.ai/kr">Homepage</a>
      <a href="https://www.enhans.ai/kr/newsroom">Newsroom</a>
      <a href="https://www.enhans.ai/kr/documents">Documents</a>
      <a href="https://enhanscareer.ninehire.site/recruit" target="_blank" rel="noopener noreferrer">Careers</a>
      <a href="https://www.youtube.com/@enhans-ai" target="_blank" rel="noopener noreferrer">Youtube</a>
      <a href="https://www.linkedin.com/company/enhans-ai/posts/?feedView=all" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
  </div>
</header>
